# ==== 模型服务配置（OpenAI 兼容协议，默认智谱开放平台）====

# API Key：在 https://open.bigmodel.cn 的「API Keys」页面创建
LLM_API_KEY=在此填入你的智谱APIKey

# 接口地址。换其他平台只需改这一行，例如硅基流动: https://api.siliconflow.cn/v1
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# 模型名：glm-4.5-flash（免费，推荐）
# 可选：glm-4-flash（更轻更快）、glm-4.7-flash（更新，若平台已开放）
LLM_MODEL=glm-4.5-flash

# 视觉模型：上传图片时用它识别内容与版式（智谱免费视觉模型；旧款可用 glm-4v-flash）
LLM_VISION_MODEL=glm-4.6v-flash

# 单次生成最大输出 token（文档较长时可调大）
LLM_MAX_TOKENS=8192

# 编译失败后自动修复的最大轮数
MAX_FIX_ROUNDS=3

# 单次编译超时（秒）。首次编译某类文档需联网下载宏包，会较慢
COMPILE_TIMEOUT=180

# 单个附件大小上限（MB）
MAX_UPLOAD_MB=10

# 服务监听地址与端口。局域网开放改为 0.0.0.0 并放行防火墙
HOST=127.0.0.1
PORT=8000
